{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "moduleDetection": "force",
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declarationMap": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalConsole": "error",
          "globalConsoleInEffect": "error"
        },
        "allowedUnstableApis": [
          "@effect/platform-node/NodeRuntime#runMain"
        ],
        "overrides": [
          {
            "include": ["src/mcp/registry.ts"],
            "options": { "allowedUnstableApis": [
              "effect/ai/McpSchema#CallToolResult", "effect/ai/McpSchema#Tool",
              "effect/ai/McpSchema#ToolJson", "effect/ai/McpSchema#ToolOutputJson",
              "effect/ai/McpServer#McpServer"
            ] }
          },
          {
            "include": ["src/mcp/stdio.ts"],
            "options": { "allowedUnstableApis": [
              "effect/PlatformError#badArgument",
              "effect/Stdio#Stdio", "effect/Stdio#make", "@effect/platform-node/NodeStdio#layer",
              "effect/ai/McpServer#layerStdio", "effect/ai/McpProtocol#v2025_11_25",
              "effect/ai/McpProtocol#v2025_06_18", "effect/ai/McpProtocol#v2025_03_26",
              "effect/ai/McpProtocol#v2024_11_05"
            ] }
          },
          {
            "include": [
              "src/**/*.test.ts"
            ],
            "options": {
              "allowedUnstableApis": [
                "@effect/vitest#it"
              ]
            }
          },
          {
            "include": ["src/mcp/stdio.test.ts"],
            "options": { "allowedUnstableApis": ["@effect/vitest#it", "effect/PlatformError#badArgument",
              "effect/Stdio#Stdio", "effect/Stdio#make"] }
          }
        ]
      }
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
